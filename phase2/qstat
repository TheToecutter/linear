#!/usr/bin/env python3
import json
d = json.load(open('/home/stevemolloy/Projects/linear/phase2/phase2_queue_logs/queue_status.json'))
glyph = {'done': '✓', 'running': '▶', 'failed': '✗', 'queued': '·', 'skipped': '○'}
total_s = sum(t['elapsed_s'] for t in d['tasks'] if t['elapsed_s'])
for i, t in enumerate(d['tasks'], 1):
    g = glyph.get(t['status'], '?')
    mins = t['elapsed_s'] / 60 if t['elapsed_s'] else 0
    extra = ''
    if t['status'] in ('done', 'failed'):
        extra = f'  ({mins:.1f} min)'
    elif t['status'] == 'running':
        extra = f'  RUNNING for {mins:.1f} min'
    print(f"  {g} [{i:>2}/{len(d['tasks'])}] {t['id']:<42s} {t['status']:<8s}{extra}")
print()
print(f"  Compute so far: {total_s/3600:.2f} hr  |  Started: {d['started_at'][:19]}  |  Updated: {d['updated_at'][:19]}")
